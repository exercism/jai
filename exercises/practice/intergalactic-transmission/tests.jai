run_tests :: () {
    empty_message();
    skip(value_0x00_is_transmitted_as_0x0000());
    skip(value_0x02_is_transmitted_as_0x0300());
    skip(value_0x06_is_transmitted_as_0x0600());
    skip(value_0x05_is_transmitted_as_0x0581());
    skip(value_0x29_is_transmitted_as_0x2881());
    skip(value_0xc001c0de_is_transmitted_as_0xc000711be1());
    skip(six_byte_message());
    skip(seven_byte_message());
    skip(eight_byte_message());
    skip(twenty_byte_message());
    skip(empty_message());
    skip(zero_message());
    skip(value_0x0300_is_decoded_to_0x02());
    skip(value_0x0581_is_decoded_to_0x05());
    skip(value_0x2881_is_decoded_to_0x29());
    skip(first_byte_has_wrong_parity());
    skip(second_byte_has_wrong_parity());
    skip(value_0xcf4b00_is_decoded_to_0xce94());
    skip(value_0xe2566500_is_decoded_to_0xe2ad90());
    skip(six_byte_message());
    skip(seven_byte_message());
    skip(last_byte_has_wrong_parity());
    skip(eight_byte_message());
    skip(twenty_byte_message());
    skip(wrong_parity_on_16th_byte());
}

empty_message :: () {
    assert_equal(.[], transmit_sequence(.[]));
}

value_0x00_is_transmitted_as_0x0000 :: () {
    assert_equal(.[0x00, 0x00], transmit_sequence(.[0x00]));
}

value_0x02_is_transmitted_as_0x0300 :: () {
    assert_equal(.[0x03, 0x00], transmit_sequence(.[0x02]));
}

value_0x06_is_transmitted_as_0x0600 :: () {
    assert_equal(.[0x06, 0x00], transmit_sequence(.[0x06]));
}

value_0x05_is_transmitted_as_0x0581 :: () {
    assert_equal(.[0x05, 0x81], transmit_sequence(.[0x05]));
}

value_0x29_is_transmitted_as_0x2881 :: () {
    assert_equal(.[0x28, 0x81], transmit_sequence(.[0x29]));
}

value_0xc001c0de_is_transmitted_as_0xc000711be1 :: () {
    assert_equal(.[0xc0, 0x00, 0x71, 0x1b, 0xe1], transmit_sequence(.[0xc0, 0x01, 0xc0, 0xde]));
}

six_byte_message :: () {
    assert_equal(.[0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0x84], transmit_sequence(.[0x47, 0x72, 0x65, 0x61, 0x74, 0x21]));
}

seven_byte_message :: () {
    assert_equal(.[0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0xc5, 0x42], transmit_sequence(.[0x47, 0x72, 0x65, 0x61, 0x74, 0x31, 0x21]));
}

eight_byte_message :: () {
    assert_equal(.[0xc0, 0x00, 0x44, 0x66, 0x7d, 0x06, 0x78, 0x42, 0x21, 0x81], transmit_sequence(.[0xc0, 0x01, 0x13, 0x37, 0xc0, 0xde, 0x21, 0x21]));
}

twenty_byte_message :: () {
    assert_equal(.[0x44, 0xbd, 0x18, 0xaf, 0x27, 0x1b, 0xa5, 0xe7, 0x6c, 0x90, 0x1b, 0x2e, 0x33, 0x03, 0x84, 0xee, 0x65, 0xb8, 0xdb, 0xed, 0xd7, 0x28, 0x84], transmit_sequence(.[0x45, 0x78, 0x65, 0x72, 0x63, 0x69, 0x73, 0x6d, 0x20, 0x69, 0x73, 0x20, 0x61, 0x77, 0x65, 0x73, 0x6f, 0x6d, 0x65, 0x21]));
}

empty_message :: () {
    ok, decoded_message := decode_message(.[]);
    assert_equal(true, ok);
    assert_equal(.[], decoded_message);
}

zero_message :: () {
    ok, decoded_message := decode_message(.[0x00, 0x00]);
    assert_equal(true, ok);
    assert_equal(.[0x00], decoded_message);
}

value_0x0300_is_decoded_to_0x02 :: () {
    ok, decoded_message := decode_message(.[0x03, 0x00]);
    assert_equal(true, ok);
    assert_equal(.[0x02], decoded_message);
}

value_0x0581_is_decoded_to_0x05 :: () {
    ok, decoded_message := decode_message(.[0x05, 0x81]);
    assert_equal(true, ok);
    assert_equal(.[0x05], decoded_message);
}

value_0x2881_is_decoded_to_0x29 :: () {
    ok, decoded_message := decode_message(.[0x28, 0x81]);
    assert_equal(true, ok);
    assert_equal(.[0x29], decoded_message);
}

first_byte_has_wrong_parity :: () {
    ok, _ := decode_message(.[0x07, 0x00]);
    assert_equal(false, ok);
}

second_byte_has_wrong_parity :: () {
    ok, _ := decode_message(.[0x03, 0x68]);
    assert_equal(false, ok);
}

value_0xcf4b00_is_decoded_to_0xce94 :: () {
    ok, decoded_message := decode_message(.[0xcf, 0x4b, 0x00]);
    assert_equal(true, ok);
    assert_equal(.[0xce, 0x94], decoded_message);
}

value_0xe2566500_is_decoded_to_0xe2ad90 :: () {
    ok, decoded_message := decode_message(.[0xe2, 0x56, 0x65, 0x00]);
    assert_equal(true, ok);
    assert_equal(.[0xe2, 0xad, 0x90], decoded_message);
}

six_byte_message :: () {
    ok, decoded_message := decode_message(.[0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0x84]);
    assert_equal(true, ok);
    assert_equal(.[0x47, 0x72, 0x65, 0x61, 0x74, 0x21], decoded_message);
}

seven_byte_message :: () {
    ok, decoded_message := decode_message(.[0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0xc5, 0x42]);
    assert_equal(true, ok);
    assert_equal(.[0x47, 0x72, 0x65, 0x61, 0x74, 0x31, 0x21], decoded_message);
}

last_byte_has_wrong_parity :: () {
    ok, _ := decode_message(.[0x47, 0xb8, 0x99, 0xac, 0x17, 0xa0, 0xc5, 0x43]);
    assert_equal(false, ok);
}

eight_byte_message :: () {
    ok, decoded_message := decode_message(.[0xc0, 0x00, 0x44, 0x66, 0x7d, 0x06, 0x78, 0x42, 0x21, 0x81]);
    assert_equal(true, ok);
    assert_equal(.[0xc0, 0x01, 0x13, 0x37, 0xc0, 0xde, 0x21, 0x21], decoded_message);
}

twenty_byte_message :: () {
    ok, decoded_message := decode_message(.[0x44, 0xbd, 0x18, 0xaf, 0x27, 0x1b, 0xa5, 0xe7, 0x6c, 0x90, 0x1b, 0x2e, 0x33, 0x03, 0x84, 0xee, 0x65, 0xb8, 0xdb, 0xed, 0xd7, 0x28, 0x84]);
    assert_equal(true, ok);
    assert_equal(.[0x45, 0x78, 0x65, 0x72, 0x63, 0x69, 0x73, 0x6d, 0x20, 0x69, 0x73, 0x20, 0x61, 0x77, 0x65, 0x73, 0x6f, 0x6d, 0x65, 0x21], decoded_message);
}

wrong_parity_on_16th_byte :: () {
    ok, _ := decode_message(.[0x44, 0xbd, 0x18, 0xaf, 0x27, 0x1b, 0xa5, 0xe7, 0x6c, 0x90, 0x1b, 0x2e, 0x33, 0x03, 0x84, 0xef, 0x65, 0xb8, 0xdb, 0xed, 0xd7, 0x28, 0x84]);
    assert_equal(false, ok);
}

#run {
    before_running_tests();
    run_tests();
    after_running_tests();
}

#load "solution.jai";
#load "extest.jai";
